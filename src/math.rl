#
Abstract Mathematical Vectors, Curves & Probability Distributions
#

Vector1(T) { X T }
Vector2(T) { X T, Y T }
Vector3(T) { X T, Y T, Z T }
Vector4(T) { X T, Y T, Z T, W T }

ICurve { Evaluate Any }

DescriptiveStats {
  Count    Int
  Mean     Float
  Median   Float
  Mode     Float
  Variance Float
  StdDev   Float
  Min      Float
  Max      Float
  Skewness Float
  Kurtosis Float
}
