// 1 simplicity 2 symmetry 3 history 4 keyboard

// text
// split
SPACE ' '
NEWLINE '\n'
DOT '.'
COMMA ','
COLON ':'
SEMICOLON ''
EQUALS '='
PIPE '|'
PERCENT '%'
//join
DASH '-'
UNDERSCORE '_'
PLUS '+'
CARET '^'
TILDE '~'
ASTERISK '*'
AMPERSAND '&'
AT_SIGN '@'

// group
// mono
DOUBLE_QUOTE '"'
// open
ANGLE_OPEN '<'
PAREN_OPEN '('
BRACKET_OPEN '['
BRACE_OPEN '{'
// close
ANGLE_CLOSE '>'
PAREN_CLOSE ')'
BRACKET_CLOSE ']'
BRACE_CLOSE '}'
// slash
SLASH '/'
BACKSLASH '\\'

// priority
SINGLE_QUOTE '\''
BACKTICK '`'
EXCLAMATION '!'
QUESTION '?'
HASH '#'
DOLLAR '$'
