1. Media Types (MIME Types)
    { "extension": "pdf", "mime_type": "application/pdf", "category": "Document", "binary": true }
2. Unicode & Emojis
{ "emoji": "🚀", "name": "rocket", "category": "Travel & Places", "code_point": "U+1F680" }
3. Programming Languages
{ "name": "Python", "slug": "python", "extensions": [".py", ".pyw"], "paradigm": "Multi-paradigm" }
4. Countries & Subdivisions
{ "name": "Canada", "alpha2": "CA", "alpha3": "CAN", "numeric": "124", "phone_code": "+1", "currency": "CAD" }
5. Locales and Languages (BCP 47)
{ "locale": "es-MX", "language": "Spanish", "territory": "Mexico", "script": "Latn", "rtl": false }
6. Cities & Geo-Coordinates
{ "city": "Tokyo", "country": "Japan", "lat": 35.6762, "lng": 139.6503, "timezone": "Asia/Tokyo" }
7. Jobs & Occupations
{ "title": "Software Engineer", "department": "Technology", "soc_code": "15-1252" }
8. Currencies & Financial Data
{ "code": "EUR", "name": "Euro", "symbol": "€", "decimals": 2, "countries": ["FR", "DE", "IT"] }
9. Timezones & Calendars
{ "identifier": "America/New_York", "utc_offset": "-05:00", "dst": true }
10. Postal & Zip Code Formats
{ "country": "US", "regex": "^\\d{5}(-\\d{4})?$", "example": "90210" }
11. Phone Number Dialing Codes
{ "country": "United Kingdom", "alpha2": "GB", "dial_code": "+44", "length": 10 }
12. Colors & Design Palettes
{ "name": "Tailwind Blue 500", "hex": "#3b82f6", "rgb": "59, 130, 246", "hsl": "217, 91%, 60%" }
13. File Extensions & Icons
{ "extension": "md", "mime_type": "text/markdown", "icon": "file-code", "category": "Text" }
14. Domain TLDs
{ "tld": ".io", "type": "gTLD", "registry": "Internet Assigned Numbers Authority" }
15. User-Agent Strings & Browsers
{ "browser": "Chrome", "os": "Windows", "device": "Desktop", "sample_ua": "Mozilla/5.0 (Windows NT 10.0...)" }
16. Units of Measurement
{ "name": "Kilogram", "symbol": "kg", "dimension": "Mass", "si_base": "kg" }
17. Dietary & Allergens
{ "item": "Peanut Butter", "diet_flags": ["Vegan", "Vegetarian", "Keto"], "allergens": ["Peanuts"] }
18. Universities & Higher Education
{ "name": "Harvard University", "country": "United States", "domain": "harvard.edu", "web_page": "https://www.harvard.edu" }
19. Airports & Airlines
{ "iata": "JFK", "icao": "KJFK", "name": "John F. Kennedy International Airport", "city": "New York" }
20. Content & Dummy   (Lorem Ipsum)
